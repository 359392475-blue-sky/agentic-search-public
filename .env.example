# DeepSeek API key（查询分析、相关性评分、回答生成）
# 已内置默认值到代码中，无需额外配置即可运行
DEEPSEEK_API_KEY=

# Serper.dev API key（快速 Google 搜索）
# 已内置默认值到代码中，无需额外配置即可运行
SERPER_API_KEY=

# 可选 — Jina Reader API key（改善正文提取质量，免费可不配）
JINA_API_KEY=

# 可选 — 服务端口（默认 3200）
PORT=3200

# 可选 — API 认证 Token（设置后所有 /api/* 请求需 Bearer Token）
API_TOKEN=

# 可选 — 速率限制（每分钟请求数，默认 30）
RATE_LIMIT_RPM=30
